          "_name": "features03",
          "_sourceTheme": "divem5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features03 divem5\" group=\"Features\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"12\" step=\"1\" value=\"1\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"12\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <header>Cards</header>\n        <input type=\"checkbox\" title=\"Card Title\" name=\"showCardTitle\" checked>\n        <input type=\"checkbox\" title=\"Card Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Card Price\" name=\"showPrice\">\n        <input type=\"checkbox\" title=\"Card Description\" name=\"showDesc\">\n        <input type=\"color\" title=\"Description BG\" value=\"#f7f7f7\" name=\"descBg\" condition=\"showDesc\" selected>\n        <input type=\"checkbox\" title=\"Card Icon\" name=\"showIcon\" checked>\n        <input type=\"color\" title=\"Icon Color\" value=\"#000000\" name=\"icon\" condition=\"showIcon\" selected>\n        <input type=\"color\" title=\"Icon BG\" value=\"#f7f7f7\" name=\"iconBg\" condition=\"showIcon\" selected>\n        <input type=\"color\" title=\"Active Bg\" value=\"#f92c50\" name=\"activeBg\" selected>\n        <input type=\"color\" title=\"Active Color\" value=\"#f7f7f7\" name=\"active\" selected>\n        <input type=\"color\" title=\"Border Color\" value=\"#e1e1e1\" name=\"border\" selected>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background1-2.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#f7f7f7\" selected>\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background1-2.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.3\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <div class=\"title-wrapper\">\n                    <h2 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\"><b>Jurado 2026 /&nbsp;</b><b style=\"font-size: 1.8rem;\">Líderes que evalúan&nbsp;</b><b style=\"font-size: 1.8rem;\">con criterio real:</b></h2>\n                </div>\n            </div>\n        </div>\n        <div class=\"row\">\n            \n            <div class=\"item features-image col-12 active\">\n                <div class=\"item-wrapper\">\n                    <a href=\"#\" class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/juansolana-660x660.jpg\" alt=\"Mobirise Website Builder\">\n                    </a>\n                    <div class=\"item-content\">\n                        <div class=\"content-wrap\">\n                            <a class=\"desc-wrap\" mbr-if=\"showDesc\">\n                                <p class=\"item-desc mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-desc\">\n                                    10 DAYS\n                                </p>\n                            </a>\n                            <h5 class=\"item-subtitle mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-subtitle\" mbr-if=\"showSubtitle\"><b>Juan Solana</b></h5>\n                            <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\"><div><b>EY México.</b> Especialista en innovación y transformación corporativa en LATAM.</div></h4>\n                            <p class=\"item-price mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-price\" mbr-if=\"showPrice\">\n                                <b>$1800</b>\n                            </p>\n                        </div>\n                        <a href=\"https://www.linkedin.com/in/juansd/\" class=\"icon-wrapper\" mbr-if=\"showIcon\" target=\"_blank\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n                        </a>\n                    </div>\n                </div>\n            </div>\n            <div class=\"item features-image col-12\">\n                <div class=\"item-wrapper\">\n                    <a href=\"#\" class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/speranza-660x660.jpg\" alt=\"Mobirise Website Builder\">\n                    </a>\n                    <div class=\"item-content\">\n                        <div class=\"content-wrap\">\n                            <a class=\"desc-wrap\" mbr-if=\"showDesc\">\n                                <p class=\"item-desc mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-desc\">\n                                    14 DAYS\n                                </p>\n                            </a>\n                            <h5 class=\"item-subtitle mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-subtitle\" mbr-if=\"showSubtitle\"><b>Vincent Speranza</b></h5>\n                            <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\"><div><b>CEO Endeavor México</b>. Impulsor del emprendimiento e innovación en LATAM desde 2006.</div></h4>\n                            <p class=\"item-price mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-price\" mbr-if=\"showPrice\">\n                                <b>$2500</b>\n                            </p>\n                        </div>\n                        <a href=\"https://www.linkedin.com/in/vincentsperanza/\" class=\"icon-wrapper\" mbr-if=\"showIcon\" target=\"_blank\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n                        </a>\n                    </div>\n                </div>\n            </div>\n            <div class=\"item features-image col-12\">\n                <div class=\"item-wrapper\">\n                    <a href=\"#\" class=\"item-img\">\n                        <img src=\"@PROJECT_PATH@/assets/images/richaud-660x660.jpg\" alt=\"Mobirise Website Builder\">\n                    </a>\n                    <div class=\"item-content\">\n                        <div class=\"content-wrap\">\n                            <a class=\"desc-wrap\" mbr-if=\"showDesc\">\n                                <p class=\"item-desc mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-desc\">\n                                    9 DAYS\n                                </p>\n                            </a>\n                            <h5 class=\"item-subtitle mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-subtitle\" mbr-if=\"showSubtitle\"><b>Gabriel Richaud</b></h5>\n                            <h4 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\"><div><b>CEO de IAB México</b>. +30 años en Marketing, Negocios Digitales y Alianzas Estratégicas.</div></h4>\n                            <p class=\"item-price mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-price\" mbr-if=\"showPrice\">\n                                <b>$1600</b>\n                            </p>\n                        </div>\n                        <a href=\"https://www.linkedin.com/in/gabrielrichaud/ \" class=\"icon-wrapper\" mbr-if=\"showIcon\" target=\"_blank\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-plus mobi-mbri\"></span>\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
