                      "margin-bottom": "10px"
                    },
                    ".item-title": {
                      "margin-bottom": "10px",
                      "cursor": "pointer"
                    },
                    ".item-price": {
                      "margin": "0"
                    }
                  },
                  ".icon-wrapper": {
                    "display": "block",
                    "@media (max-width: 768px)": {
                      "margin-top": "20px"
                    },
                    "&:hover, &:focus": {
                      ".mbr-iconfont": {
                        "box-shadow": "inset 90px 0 0 0 @activeBg !important",
                        "color": "@active"
                      }
                    },
                    ".mbr-iconfont": {
                      "width": "90px",
                      "height": "90px",
                      "display": "flex",
                      "justify-content": "center",
                      "align-items": "center",
                      "color": "@icon",
                      "background-color": "@iconBg",
                      "font-size": "22px",
                      "transition": "all 0.3s ease-in-out"
                    }
                  }
                }
              }
