              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@fullWidth)": {
              ".container-fluid": {
                "padding": "0 45px",
                "@media (max-width: 992px)": {
                  "padding": "0 25px"
                }
              }
            },
            "@media (max-width: 992px)": {
              ".container": {
                "padding": "0 25px"
              }
            },
            ".row": {
              "justify-content": "center"
            },
            ".title-wrapper": {
              ".mbr-section-title": {
                "margin-bottom": "50px"
              }
            },
            ".item": {
              "&:first-child": {
                ".item-wrapper": {
                  "border-top": "2px solid @border"
                }
              },
              ".item-wrapper": {
                "padding": "22px 0",
                "border-bottom": "2px solid @border",
                "display": "flex",
                "align-items": "center",
                "border-radius": "0 !important",
                "&:hover, &:focus": {
                  ".item-img img": {
                    "transform": "scale(1.05) translateX(2%)"
                  }
                },
                "@media (max-width: 992px)": {
                  "display": "block"
                },
                ".item-img": {
                  "display": "block",
                  "overflow": "hidden",
                  "min-width": "330px",
                  "@media (max-width: 992px)": {
                    "max-width": "100%",
                    "margin-bottom": "20px",
                    "min-width": "auto"
                  },
                  "img": {
                    "height": "200px",
                    "object-fit": "cover",
                    "transition": "all 0.3s ease-in-out",
                    "transform": "scale(1.05) translateX(0)",
                    "@media (max-width: 992px)": {
                      "height": "350px"
                    }
                  }
                },
                ".item-content": {
                  "width": "100%",
                  "padding-left": "40px",
                  "display": "flex",
                  "align-items": "center",
                  "justify-content": "space-between",
                  "@media (max-width: 992px)": {
                    "padding-left": "0"
                  },
                  "@media (max-width: 768px)": {
                    "display": "block"
                  },
                  ".content-wrap": {
                    ".desc-wrap": {
                      "display": "block",
                      "&:hover, &:focus": {
                        ".item-desc": {
                          "background-color": "@activeBg",
                          "color": "@active"
                        }
                      },
                      ".item-desc": {
                        "margin-bottom": "10px",
                        "padding": "0 10px",
                        "background-color": "@descBg",
                        "display": "inline-flex",
                        "letter-spacing": ".05em",
